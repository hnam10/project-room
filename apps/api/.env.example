PORT=4000

# SurrealDB connection. Embedded engines need no server:
#   mem://                      in-memory, wiped on restart
#   surrealkv://./data/dev.db   on-disk file (default)
# Remote: ws://127.0.0.1:8000 after `surreal start --user root --pass root`
SURREAL_URL=surrealkv://./data/dev.db
SURREAL_NS=project_room
SURREAL_DB=dev
# Only used for remote (ws/http) connections
SURREAL_USER=
SURREAL_PASS=

# Clerk authentication (https://dashboard.clerk.com -> API keys). REQUIRED: the API won't start without
# them. Enable Organizations in the Clerk dashboard; each organization is a project.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Longer calls: @AI (tools and chat brainstorm drafts), Ask the project, end-of-meeting summary.
# https://platform.openai.com. Without this key those jobs use Nebius when NEBIUS_API_KEY is set.
# AI_PROVIDER=mock forces the mock even when a key is set.
# OPENAI_FAST_MODEL is the live meeting model only when Nebius is not configured.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FAST_MODEL=gpt-4.1-mini
AI_PROVIDER=

# Frequent short calls: open-question check, live meeting suggestions, brainstorm classification,
# board facilitation, and research summaries. https://tokenfactory.nebius.com
# Meeting speech-to-text stays on Groq via GROQ_API_KEY and is not one of these calls.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=openai/gpt-oss-120b

# Meeting speech-to-text (Whisper). Without a key, browsers use the Web Speech API.
GROQ_API_KEY=

# Optional web research for `@AI brainstorm ...`. Get a key from https://app.tavily.com.
# Without it, the AI still proposes ideas from the conversation and says that web research is unavailable.
TAVILY_API_KEY=

# Load the demo project into this Clerk organization on startup (only if it has no project yet).
# Find the id (org_...) in the Clerk dashboard, or `npm run db:seed -- --org org_...` while the API is stopped.
SEED_ORG_ID=

# WebRTC ICE servers for meeting voice, as a JSON array (add a TURN server for restrictive networks).
# Default: Google's public STUN server.
# RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
RTC_ICE_SERVERS=

# Uploaded file bytes. Metadata stays in SurrealDB. Defaults to ./data/files next to the database.
# The Docker image sets this to /data/files so the /data volume keeps uploads too.
FILES_DIR=

# SurrealDB Agent Memory. Set all three so PDF, image, and plain-text uploads are indexed and @AI can
# read short passages from them. Word and PowerPoint stay download-only. Leave unset to skip.
AGENT_MEMORY_ENDPOINT=
AGENT_MEMORY_API_KEY=
AGENT_MEMORY_CONTEXT=
