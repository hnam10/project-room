PORT=4000

# SurrealDB connection. Embedded engines need no server:
#   mem://                      in-memory, wiped on restart
#   surrealkv://./data/dev.db   on-disk file (default)
# Remote: ws://127.0.0.1:8000 after `surreal start --user root --pass root`
SURREAL_URL=surrealkv://./data/dev.db
SURREAL_NS=project_room
SURREAL_DB=dev
# Only used for remote (ws/http) connections
SURREAL_USER=
SURREAL_PASS=

# Seed the demo project when the database is empty
SEED_WHEN_EMPTY=true

# AI provider: only "mock" exists today (local rules, no external calls)
AI_PROVIDER=mock

# Clerk authentication (https://dashboard.clerk.com → API keys). Leave empty for dev mode, where the
# web app's "Acting as" picker chooses the member. With keys, a Clerk Organization is a project.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
