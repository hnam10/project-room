{
  "expo": {
    "name": "Project Room",
    "slug": "project-room",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "project-room",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.projectroom.app"
    },
    "android": {
      "package": "com.projectroom.app",
      "adaptiveIcon": {
        "backgroundColor": "#efedff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "iconColor": "#5b4ff0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false,
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0631ac13-f674-427c-8844-a897121bcfc7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0631ac13-f674-427c-8844-a897121bcfc7"
    }
  }
}
